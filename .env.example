# Client-safe values (VITE_ variables are bundled into the browser)
VITE_API_BASE_URL=http://localhost:3001
VITE_APP_URL=http://localhost:5173
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_FLW_PUBLIC_KEY=your_flutterwave_public_key

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Used by the Supabase CLI only, never by the app runtime
SUPABASE_DB_PASSWORD=your_database_password
OPENAI_API_KEY=your_openai_api_key
PEXELS_API_KEY=your_pexels_api_key
BRAVE_API_KEY=your_brave_search_api_key
RESEND_API_KEY=your_resend_api_key
FLW_SECRET_KEY=your_flutterwave_secret_key
FLW_HASH=your_flutterwave_webhook_hash

# Server/deployment configuration
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
APP_ORIGIN=http://localhost:5173

# Optional: required only by the publish-to-Vercel builder flow
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
