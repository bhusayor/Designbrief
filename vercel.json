{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/submit-intake.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/claude.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/claude-stream.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
