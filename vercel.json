{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/connectors/status.js": { "memory": 256, "maxDuration": 10 },
    "api/connectors/index.js": { "memory": 512, "maxDuration": 20 }
  },
  "rewrites": [
    { "source": "/api/connectors/figma", "destination": "/api/connectors" },
    { "source": "/api/connectors/github", "destination": "/api/connectors" },
    { "source": "/api/connectors/notion", "destination": "/api/connectors" },
    { "source": "/api/connectors/gdocs", "destination": "/api/connectors" },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
